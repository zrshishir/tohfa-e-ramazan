# Keep the build context clean, and keep secrets out of the image.
#
# The Dockerfile ends with `COPY ./ ./`, so without this file everything in the working
# tree is baked into the image — including .env and the host's vendor directory.

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
#
# The image must never carry a .env. Configuration has to be supplied at runtime
# (docker-compose `environment:`, `--env-file`, or the host's env), which is the only way
# to be sure production is not silently inheriting a developer's settings.
#
# This matters beyond the secrets: the committed .env carries APP_ENV=local and
# APP_DEBUG=true. Laravel's dotenv is immutable, so real environment variables win over
# the file — but any key the environment does NOT set would fall back to those values,
# which in production means debug stack traces on any error.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Dependencies — installed inside the image, never copied from the host
# ---------------------------------------------------------------------------
#
# `composer install` runs earlier in the Dockerfile and writes vendor/ inside the
# container. Copying the host's vendor/ over the top would replace it with one resolved
# against macOS and whatever PHP the developer happens to run.
vendor
node_modules

# ---------------------------------------------------------------------------
# Version control and CI
# ---------------------------------------------------------------------------
.git
.github

# .gitignore and .gitattributes are deliberately NOT excluded. Laravel keeps empty
# storage/framework/* directories alive with .gitignore files, and the container needs
# those directories to exist in order to write sessions and compiled views. They are a few
# bytes each; excluding them buys nothing and risks a container that cannot boot.

# ---------------------------------------------------------------------------
# Local tooling and editors
# ---------------------------------------------------------------------------
.idea
.vscode
.fleet
.DS_Store
.phpunit.result.cache
.phpunit.cache
auth.json
Homestead.json
Homestead.yaml

# ---------------------------------------------------------------------------
# Runtime state that belongs to the host, not the image
# ---------------------------------------------------------------------------
#
# Only log files and compiled caches are excluded. The storage/framework/* directories are
# deliberately left alone: Laravel needs them to exist, and they are kept in git by
# .gitignore files that a broader pattern here would strip, leaving the container unable
# to write sessions or compiled views.
storage/logs/*.log

# The stale v2 manifest in here is what stopped the app booting after the Filament
# upgrade. It is regenerated by package:discover during the build.
bootstrap/cache/*.php

# ---------------------------------------------------------------------------
# Documentation and compose (not needed at runtime)
# ---------------------------------------------------------------------------
docs
docker-compose.yml
Dockerfile
*.md
!CHANGELOG.md
